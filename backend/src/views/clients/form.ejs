<%- include('../partials/header') %><div class="page-head"><div><p class="eyebrow">Clientes</p><h1><%=title%></h1></div><a href="/clients">Volver</a></div><section class="panel form-panel"><%if(errors.length){%><div class="alert error"><ul><%errors.forEach(e=>{%><li><%=e%></li><%})%></ul></div><%}%><form class="form-grid" method="post" action="<%=customer.id?'/clients/'+customer.id+'?_method=PUT':'/clients/blocked-demo'%>"><label class="wide">Nombre *<input name="name" value="<%=customer.name||''%>" required></label><label>Tipo *<select name="type" required><%types.forEach(t=>{%><option value="<%=t%>" <%=customer.type===t?'selected':''%>><%=t%></option><%})%></select></label><label>Teléfono<input name="phone" value="<%=customer.phone||''%>"></label><label class="wide">Email<input type="email" name="email" value="<%=customer.email||''%>"></label><label class="wide">Observaciones<textarea name="notes" rows="4"><%=customer.notes||''%></textarea></label><div class="wide form-actions"><a class="button secondary" href="/clients">Cancelar</a><button class="button primary">Guardar cliente</button></div></form></section><%- include('../partials/footer') %>
