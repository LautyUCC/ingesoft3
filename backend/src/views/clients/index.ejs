<%- include('../partials/header') %><div class="page-head"><div><p class="eyebrow">Agenda comercial</p><h1>Clientes</h1></div><a class="button primary" href="/clients/new">+ Nuevo cliente</a></div><% if(message){%><div class="alert"><%= message %></div><%}%><section class="panel"><div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Tipo</th><th>Contacto</th><th>Acciones</th></tr></thead><tbody><% clients.forEach(c=>{%><tr><td><strong><%=c.name%></strong></td><td><span class="badge"><%=c.type%></span></td><td><%=c.email||c.phone||'—'%></td><td class="actions"><a href="/clients/<%=c.id%>/edit">Editar</a><form action="/clients/<%=c.id%>?_method=DELETE" method="post" onsubmit="return confirm('¿Eliminar este cliente?')"><button class="danger-link">Eliminar</button></form></td></tr><%})%></tbody></table></div><%if(!clients.length){%><p class="empty">Todavía no hay clientes.</p><%}%></section><%- include('../partials/footer') %>
