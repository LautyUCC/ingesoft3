<%- include('partials/header') %><div class="page-head"><div><p class="eyebrow">Resumen general</p><h1>Dashboard</h1></div><a class="button primary" href="/coverages/new">+ Nueva cobertura</a></div>
<section class="stats"><article><span>Total</span><strong><%= stats.total %></strong><small>Coberturas registradas</small></article><article><span>Pendientes</span><strong><%= stats.pending %></strong><small>Por realizar</small></article><article><span>Entregadas</span><strong><%= stats.delivered %></strong><small>Trabajo finalizado</small></article><article><span>Pagos pendientes</span><strong><%= stats.unpaid %></strong><small>Pendiente o parcial</small></article></section>
<section class="player-summary"><article><span>Ingresos totales</span><strong><%=formatMoney(financials.revenue_total)%></strong></article><article><span>Ingresos cobrados</span><strong><%=formatMoney(financials.revenue_collected)%></strong></article><article><span>Ingresos pendientes</span><strong><%=formatMoney(financials.revenue_pending)%></strong></article><article><span>Ventas individuales</span><strong><%=formatMoney(financials.individual_sales)%></strong></article><article><span>Ventas por equipos</span><strong><%=formatMoney(financials.team_sales)%></strong></article><article><span>Compradores / fotos</span><strong><%=financials.player_buyers%> / <%=financials.photos_sold%></strong><small><%=financials.coverages_pending%> coberturas por cobrar</small></article></section>
<section class="panel"><div class="panel-head"><h2>Próximas coberturas</h2><a href="/coverages">Ver todas</a></div><% if(!stats.upcoming.length){ %><p class="empty">No hay próximas coberturas.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Evento</th><th>Cliente</th><th>Estado</th></tr></thead><tbody><% stats.upcoming.forEach(c=>{ %><tr><td><%= formatDate(c.event_date) %></td><td><a href="/coverages/<%= c.id %>"><%= c.event_name %></a></td><td><%= c.client_name %></td><td><span class="badge"><%= c.status %></span></td></tr><% }) %></tbody></table></div><% } %></section><%- include('partials/footer') %>
