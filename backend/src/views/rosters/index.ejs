<%- include('../partials/header') %><div class="page-head"><div><p class="eyebrow">Base permanente</p><h1>Planteles</h1></div></div><%if(message){%><div class="alert"><%=message%></div><%}%><section class="panel"><h2>Buscar y filtrar</h2><form method="get" class="form-grid"><label>Equipo<select name="team_id"><option value="">Todos</option><%teams.forEach(t=>{%><option value="<%=t.id%>" <%=String(filters.team_id)===String(t.id)?'selected':''%>><%=t.name%></option><%})%></select></label><label>División<select name="division_id"><option value="">Todas</option><%divisions.forEach(d=>{%><option value="<%=d.id%>" <%=String(filters.division_id)===String(d.id)?'selected':''%>><%=d.name%></option><%})%></select></label><label class="wide">Buscar jugador<input name="q" value="<%=filters.q||''%>" placeholder="Menta"></label><button class="button secondary">Buscar</button></form></section><section class="panel"><h2>Agregar al plantel</h2><form method="post" action="/rosters" class="form-grid"><label class="wide">Jugador existente<select name="player_id"><option value="">Crear nuevo</option><%found.forEach(p=>{%><option value="<%=p.id%>"><%=p.last_name%>, <%=p.first_name%> — <%=p.rosters%></option><%})%></select></label><label>Nombre nuevo<input name="first_name"></label><label>Apellido nuevo<input name="last_name"></label><label>Equipo<select name="team_id"><%teams.forEach(t=>{%><option value="<%=t.id%>"><%=t.name%></option><%})%></select></label><label>División<select name="division_id"><%divisions.forEach(d=>{%><option value="<%=d.id%>"><%=d.name%></option><%})%></select></label><label>Temporada<input type="number" name="season" value="<%=year%>"></label><div class="form-actions"><button class="button primary">Agregar</button></div></form></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Jugador</th><th>Plantel</th><th>Temporada</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><%members.forEach(m=>{%><tr><td><a href="/players/<%=m.player_id%>"><%=m.first_name%> <%=m.last_name%></a></td><td><%=m.team_name%> — <%=m.division_name%></td><td><%=m.season%></td><td><span class="badge"><%=m.active?'Activo':'Inactivo'%></span></td><td class="actions"><form method="post" action="/rosters/<%=m.id%>/toggle"><button class="danger-link"><%=m.active?'Inactivar':'Activar'%></button></form><form method="post" action="/rosters/<%=m.id%>?_method=DELETE"><button class="danger-link">Quitar del plantel</button></form></td></tr><%})%></tbody></table></div></section><%- include('../partials/footer') %>
