<%- include('../partials/header') %><div class="page-head"><div><p class="eyebrow"><%=coverage.event_name%></p><h1><%=title%></h1></div><a href="/coverages/<%=coverage.id%>">Volver</a></div><section class="panel form-panel"><%if(errors.length){%><div class="alert error"><ul><%errors.forEach(e=>{%><li><%=e%></li><%})%></ul></div><%}%><form class="form-grid" method="post" action="<%=entry.id?'/coverage-players/'+entry.id+'?_method=PUT':'/coverages/'+coverage.id+'/players'%>"><%if(!entry.id){%><label class="wide">Jugador existente<select name="player_id"><option value="">Crear nuevo</option><%allPlayers.forEach(p=>{%><option value="<%=p.id%>"><%=p.last_name%>, <%=p.first_name%> — <%=p.rosters%></option><%})%></select></label><label>Nombre nuevo<input name="first_name"></label><label>Apellido nuevo<input name="last_name"></label><label class="wide check"><input type="checkbox" name="add_to_roster"> Agregar también al plantel elegido</label><%}else{%><div class="wide identity"><strong><%=entry.first_name%> <%=entry.last_name%></strong></div><%}%><label>Equipo<select name="team_id"><%teams.forEach(t=>{%><option value="<%=t.id%>" <%=String(entry.team_id)===String(t.id)?'selected':''%>><%=t.side%>: <%=t.name%> — <%=t.division%></option><%})%></select></label><label>Dorsal<input type="number" min="0" name="jersey_number" value="<%=entry.jersey_number??''%>"></label><label>Fotos<input type="number" min="0" name="photos_taken" value="<%=entry.photos_taken??0%>"></label><label>Compra<select name="purchase_type"><%Object.entries(pricing.products).forEach(([k,p])=>{%><option value="<%=k%>" <%=entry.purchase_type===k?'selected':''%>><%=p.label%> — <%=formatMoney(p.price)%></option><%})%></select></label><label>Pago<select name="player_payment_status"><%PAYMENT_STATUSES.forEach(s=>{%><option <%=entry.player_payment_status===s?'selected':''%>><%=s%></option><%})%></select></label><label>Entrega<select name="status"><%PLAYER_STATUSES.forEach(s=>{%><option <%=entry.status===s?'selected':''%>><%=s%></option><%})%></select></label><label class="check"><input type="checkbox" name="requested_photos" <%=entry.requested_photos?'checked':''%>> Pidió fotos</label><label class="check"><input type="checkbox" name="is_additional_sale" <%=entry.is_additional_sale?'checked':''%>> Venta adicional</label><label class="wide">Observaciones<textarea name="notes"><%=entry.notes||''%></textarea></label><div class="wide form-actions"><button class="button primary">Guardar</button></div></form></section><%- include('../partials/footer') %>
