<%- include('../partials/header') %><div class="page-head"><div><p class="eyebrow">Historial del jugador</p><h1><%=player.first_name%> <%=player.last_name%></h1></div><a href="/rosters">Volver</a></div><section class="stats"><article><span>Coberturas</span><strong><%=player.coverages%></strong></article><article><span>Fotos históricas</span><strong><%=player.total_photos%></strong></article><article><span>Compras</span><strong><%=player.purchases%></strong></article><article><span>Monto histórico</span><strong><%=formatMoney(player.historical_amount)%></strong></article></section><section class="panel"><h2>Planteles</h2><%memberships.forEach(m=>{%><p><%=m.team_name%> — <%=m.division_name%> — <%=m.season%> <span class="badge"><%=m.active?'Activo':'Inactivo'%></span></p><%})%><p>Última cobertura: <strong><%=formatDate(player.last_coverage)%></strong></p></section><%- include('../partials/footer') %>
