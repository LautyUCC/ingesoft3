<%- include('../partials/header') %><div class="page-head"><h1><%=title%></h1><a href="/coverages">Volver</a></div><section class="panel form-panel"><%if(errors.length){%><div class="alert error"><ul><%errors.forEach(e=>{%><li><%=e%></li><%})%></ul></div><%}%><form class="form-grid" method="post" action="<%=coverage.id?'/coverages/'+coverage.id+'?_method=PUT':'/coverages'%>"><label class="wide">Evento *<input name="event_name" required value="<%=coverage.event_name||''%>"></label><label>Equipo local<select name="home_team_id"><%teams.forEach(t=>{%><option value="<%=t.id%>" <%=String(coverage.home_team_id)===String(t.id)?'selected':''%>><%=t.name%></option><%})%></select></label><label>División local<select name="home_division_id"><%divisions.forEach(d=>{%><option value="<%=d.id%>" <%=String(coverage.home_division_id)===String(d.id)?'selected':''%>><%=d.name%></option><%})%></select></label><label>Equipo visitante<select name="away_team_id"><%teams.forEach(t=>{%><option value="<%=t.id%>" <%=String(coverage.away_team_id)===String(t.id)?'selected':''%>><%=t.name%></option><%})%></select></label><label>División visitante<select name="away_division_id"><%divisions.forEach(d=>{%><option value="<%=d.id%>" <%=String(coverage.away_division_id)===String(d.id)?'selected':''%>><%=d.name%></option><%})%></select></label><label>Fecha<input type="date" name="event_date" required value="<%=inputDate(coverage.event_date)%>"></label><label>Lugar<input name="venue" required value="<%=coverage.venue||''%>"></label><label>Cliente<select name="client_id"><%clients.forEach(c=>{%><option value="<%=c.id%>" <%=String(coverage.client_id)===String(c.id)?'selected':''%>><%=c.name%></option><%})%></select></label><label>Precio<input type="number" name="price" min="0" value="<%=coverage.price??0%>"></label><label>Estado<select name="status"><%COVERAGE_STATUSES.forEach(s=>{%><option <%=coverage.status===s?'selected':''%>><%=s%></option><%})%></select></label><label>Pago<select name="payment_status"><%PAYMENT_STATUSES.forEach(s=>{%><option <%=coverage.payment_status===s?'selected':''%>><%=s%></option><%})%></select></label><label>Fotos<input type="number" name="photo_count" min="0" value="<%=coverage.photo_count??0%>"></label><label>Entrega<input type="date" name="delivery_date" value="<%=inputDate(coverage.delivery_date)%>"></label><label class="wide">Observaciones<textarea name="notes"><%=coverage.notes||''%></textarea></label><div class="wide form-actions"><button class="button primary">Guardar cobertura</button></div></form></section><%- include('../partials/footer') %>
