<%- include('../partials/header') %><div class="page-head"><div><p class="eyebrow"><%=formatDate(coverage.event_date)%></p><h1><%=coverage.event_name%></h1><p class="teams-title"><%=coverage.home_team_name%> <b>vs</b> <%=coverage.away_team_name%></p></div><a class="button secondary" href="/coverages/<%=coverage.id%>/edit">Editar</a></div><%if(message){%><div class="alert"><%=message%></div><%}%>
<section class="detail-grid"><article><span>Cliente</span><strong><%=coverage.client_name%></strong></article><article><span>Lugar</span><strong><%=coverage.venue%></strong></article><article><span>Total facturado</span><strong><%=formatMoney(financials.total)%></strong></article><article><span>Total cobrado</span><strong><%=formatMoney(financials.collected)%></strong></article><article><span>Total pendiente</span><strong><%=formatMoney(financials.pending)%></strong></article><article><span>Fotos vendidas</span><strong><%=summary.photos_sold%></strong></article></section><div class="section-head"><p class="eyebrow">Ventas y entregas</p><h2>Planilla de jugadores</h2></div>
<% function sheet(teamName,teamId,rows,side,total){const teamSale=teamSales.find(s=>s.team_id===teamId); %><section class="panel team-sheet"><div class="panel-head"><div><span class="badge"><%=side%></span><h2><%=teamName%></h2><p>Total: <strong><%=formatMoney(total)%></strong></p></div><a class="button primary" href="/coverages/<%=coverage.id%>/players/new?team=<%=teamId%>">+ Jugador</a></div><div class="team-sale"><%if(teamSale){%><div><strong>Cobertura completa — <%=formatMoney(teamSale.amount)%></strong> <span class="badge"><%=teamSale.payment_status%></span><p>Las ventas individuales están incluidas salvo las adicionales.</p></div><form action="/coverages/<%=coverage.id%>/teams/<%=teamId%>/sale?_method=DELETE" method="post"><button class="button danger">Quitar</button></form><%}else{%><form action="/coverages/<%=coverage.id%>/teams/<%=teamId%>/sale" method="post" class="inline-sale"><strong>Equipo compró cobertura — <%=formatMoney(pricing.teamCoveragePrice)%></strong><select name="payment_status"><option>Pendiente</option><option>Parcial</option><option>Pagado</option></select><button class="button secondary">Registrar</button></form><%}%></div>
<%if(!rows.length){%><p class="empty">No hay jugadores cargados.</p><%}else{%><div class="table-wrap"><table class="players-table"><thead><tr><th>Jugador</th><th>Disponibles</th><th>Compra</th><th>Entregadas</th><th>Precio</th><th>Pago</th><th>Entrega</th><th>Contabilización</th><th></th></tr></thead><tbody><%rows.forEach(p=>{const included=teamSale&&!p.is_additional_sale;%><tr><td><strong>#<%=p.jersey_number??'—'%> <%=p.first_name%> <%=p.last_name%></strong></td><td><%=p.photos_taken%></td><td><%=pricing.products[p.purchase_type]?.label||'No compró'%></td><td><%=p.photos_purchased%></td><td><%=formatMoney(p.agreed_price||0)%></td><td><span class="badge"><%=p.player_payment_status%></span></td><td><span class="badge"><%=p.status%></span></td><td><%if(included&&p.purchase_type!=='none'){%><span class="badge included">Incluido en cobertura</span><%}else if(p.is_additional_sale){%><span class="badge additional">Venta adicional</span><%}else{%>Individual<%}%></td><td class="actions"><a href="/coverage-players/<%=p.id%>/edit">Editar</a><form action="/coverage-players/<%=p.id%>?_method=DELETE" method="post"><button class="danger-link">Eliminar</button></form></td></tr><%})%></tbody></table></div><%}%></section><%}%><%sheet(coverage.home_team_name,coverage.home_team_id,homePlayers,'Equipo local',financials.home_total);sheet(coverage.away_team_name,coverage.away_team_id,awayPlayers,'Equipo visitante',financials.away_total);%><%- include('../partials/footer') %>
