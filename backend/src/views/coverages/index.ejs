<%- include('../partials/header') %><div class="page-head"><div><p class="eyebrow">Trabajo fotográfico</p><h1>Coberturas</h1></div><a class="button primary" href="/coverages/new">+ Nueva cobertura</a></div><%if(message){%><div class="alert"><%=message%></div><%}%><section class="panel"><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Evento</th><th>Cliente</th><th>Precio</th><th>Estado</th><th>Pago</th></tr></thead><tbody><%coverages.forEach(c=>{%><tr><td><%=formatDate(c.event_date)%></td><td><a href="/coverages/<%=c.id%>"><strong><%=c.event_name%></strong></a><small class="block"><%=c.venue%></small></td><td><%=c.client_name%></td><td><%=formatMoney(c.price)%></td><td><span class="badge status-<%=c.status.toLowerCase()%>"><%=c.status%></span></td><td><span class="badge"><%=c.payment_status%></span></td></tr><%})%></tbody></table></div><%if(!coverages.length){%><p class="empty">Todavía no hay coberturas.</p><%}%></section><%- include('../partials/footer') %>
