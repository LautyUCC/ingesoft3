{
  "all": true,
  "include": [
    "src/services/**"
  ],
  "exclude": [
    "test/**",
    "src/db/**",
    "src/app.js",
    "src/config/**",
    "src/views/**",
    "src/public/**",
    "src/controllers/**",
    "src/repositories/**",
    "src/routes/**",
    "src/middleware/**"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov"
  ],
  "check-coverage": true,
  "lines": 80,
  "branches": 70,
  "functions": 80,
  "statements": 80
}
