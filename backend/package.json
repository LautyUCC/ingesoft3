    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "method-override": "^3.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "supertest": "^7.3.1"
  }
}
