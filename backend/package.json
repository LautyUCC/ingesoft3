{
  "name": "photomatch",
  "version": "1.0.0",
  "description": "Monolito modular para gestionar coberturas fotográficas deportivas",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --test",
    "test:coverage": "c8 node --test",
