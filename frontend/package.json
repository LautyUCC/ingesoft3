{
  "name": "photomatch-e2e",
  "private": true,
  "scripts": {
    "build": "esbuild src/telemetry.js --bundle --minify --outfile=public/js/telemetry.js",
    "test:integration": "playwright test e2e/api.spec.js",
    "test:e2e": "playwright test e2e/app.spec.js",
    "test:check-coverage": "c8 --reports-dir=${COVERAGE_DIR:-coverage} --check-coverage node --test test/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0"
  },
  "dependencies": {
    "@sentry/browser": "^11.9.0",
    "esbuild": "^0.28.2"
  }
}
